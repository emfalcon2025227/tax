# Local development only. Never commit real credentials.
NODE_ENV=development
PORT=3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=replace-with-server-only-key
AUTH_SECRET_KEY=replace-with-at-least-32-random-characters

# Optional local-only bootstrap values. Leave empty unless explicitly needed.
OWNER_USER=
OWNER_PASS=
CLERK_USER=
CLERK_PASS=
